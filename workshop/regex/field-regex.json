{
  "regex": {
    "name": "^[A-Za-z ]{2,50}$",
    "firstName": "^[A-Za-z]{2,30}$",
    "lastName": "^[A-Za-z]{2,30}$",
    "phoneNumber": "^[6-9]\\d{9}$",
    "email": "^[\\w.-]+@[\\w.-]+\\.\\w{2,}$",
    "password": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@#$%^&+=!]).{8,20}$",
    "age": "^(1[89]|[2-9]\\d)$",
    "pincode": "^\\d{6}$"
  }
}
